PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

COOKIE_SECRET=replace-with-openssl-rand-base64-48

JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
JWT_REFRESH_SECRET=replace-with-openssl-rand-base64-48
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=simba
DB_USER=postgres
DB_PASSWORD=change-me

S3_REGION=ru-central1
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=your-bucket
S3_PUBLIC_URL=https://your-bucket.storage.yandexcloud.net
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM="Simba Clinic <noreply@example.com>"

# Только для node scripts/create-admin.js. Вход по этим полям напрямую не работает.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-password
